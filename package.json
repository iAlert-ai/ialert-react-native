    "url": "https://github.com/iAlert-ai/ialert-react-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iAlert-ai/ialert-react-native.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "files": [
